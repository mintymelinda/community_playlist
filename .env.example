# Public OAuth application identifiers (not client secrets).
DATA_DIR=./data
TWITCH_CLIENT_ID=replace-with-twitch-client-id
# Required for a Confidential Twitch application; keep this server-side only.
TWITCH_CLIENT_SECRET=replace-with-twitch-client-secret
SPOTIFY_CLIENT_ID=replace-with-spotify-client-id
# Set this to the public HTTPS URL of the independent static overlay host if not using GitHub Pages.
OVERLAY_BASE_URL=https://mintymelinda.github.io/community_playlist/overlay.html
