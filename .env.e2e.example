# Copy to .env.e2e. This file contains only public app IDs and test settings.
# Do not put client secrets, access tokens, refresh tokens, or authorization codes here.
PORT=4173
TWITCH_CLIENT_ID=
SPOTIFY_CLIENT_ID=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:4173/
SPOTIFY_PLAYLIST_URI=spotify:playlist:PLAYLISTID
# Prefer real Spotify track URIs/URLs to keep track selection deterministic.
E2E_TRACK_X=spotify:track:TRACKXID
E2E_TRACK_Y=spotify:track:TRACKYID
# Optional: pin the broadcaster account, Power-up and Connect device.
TWITCH_BROADCASTER_ID=
TWITCH_POWER_UP_ID=
SPOTIFY_DEVICE_ID=
POLL_INTERVAL_MS=2000
